{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "paths": {
      "@fuse": [
        "@fuse/"
      ]
    },
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "jasmine",
      "node"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "src/typings.d.ts"
  ],
  "angularCompilerOptions": {
    "enableIvy": true,
    "allowCommonJsDependencies": true
  }
}
